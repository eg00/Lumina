# ==============================================================================
# Lumina Production Environment Configuration
# ==============================================================================

# Application URL (accessed via your reverse proxy)
APP_URL=http://localhost:8080
APP_PORT=8080

# Generate key with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE

# Database Credentials
DB_DATABASE=lumina
DB_USERNAME=lumina
DB_PASSWORD=change_this_secure_database_password

# Mercure Realtime Hub JWT Secret (must match in pub/sub)
MERCURE_JWT_SECRET=change_this_to_a_random_32_character_jwt_secret

# Initial Admin User Created on First Boot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Admin

# Media Storage
# Host folder containing your photos and videos (mounted into container as read-only /photos)
MEDIA_PATH=./photos
INITIAL_MEDIA_PATH=/photos
INITIAL_MEDIA_NAME=Photos

# Container Images (default to latest official GHCR builds)
LUMINA_IMAGE=ghcr.io/eg00/lumina:latest
LUMINA_DB_IMAGE=ghcr.io/eg00/lumina-db:latest
AI_WORKER_IMAGE=ghcr.io/eg00/lumina-ai-worker:latest
